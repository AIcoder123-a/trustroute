# TrustRoute environment
# Copy to .env.local and fill in. Never commit .env.local.

# Server-side Clocked API key. Create one at https://clocked.rezolve.ai/account
# It is read only by the server process; it is never sent to the browser and
# never appears in a payload, a log line or an export.
CLOCKED_API_KEY=

# auto  — live when CLOCKED_API_KEY is set, otherwise the labelled mock (default)
# live  — require live; refuses to start without a key
# mock  — always the labelled simulator, even if a key is present
CLOCKED_MODE=auto

# Policy thresholds. Defaults shown; all optional.
# At or above this injection probability the policy blocks without a human.
POLICY_BLOCK_INJECTION=0.85
# At or above this malicious-script probability the policy blocks.
POLICY_BLOCK_SCRIPT=0.8
# This many personal-data findings forces a human review.
POLICY_REVIEW_ENTITY_COUNT=6

# Abuse control for the public demo: screens per IP per 5-minute window.
RATE_LIMIT_REQUESTS=20

# Whole-deployment ceiling per UTC day. This is what protects the account's
# credit balance on a public demo: per-IP limits do not stop many visitors.
# Default: 60 in live mode (a live screen costs 12-19 credits), 240 in mock mode
# (costs nothing). Set it lower if the demo must survive a long judging window.
DAILY_SCREENS=

# Optional: extra origins allowed to POST to /api/analyze and /api/review, for a
# reverse proxy that serves the app under another hostname. Comma-separated,
# scheme included, e.g. https://demo.example.com. Same-origin is always allowed;
# leave this empty unless you know you need it.
ALLOWED_ORIGINS=

# Optional transport overrides. Leave unset unless the provider asks for them.
# CLOCKED_BASE_URL=https://clocked.rezolve.ai/clocked
# Per-attempt timeout in milliseconds, clamped to 5000–120000. Default 30000.
# CLOCKED_TIMEOUT_MS=30000
