{
  "name": "trustroute",
  "version": "0.1.0",
  "private": true,
  "description": "TrustRoute — AI Agent Security Gateway. Inspect untrusted content before it influences an AI agent.",
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verify:live": "node --env-file-if-exists=.env.local scripts/live-acceptance.mjs",
    "verify:live:browser": "node scripts/live-verify.mjs",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build",
    "accept:live": "node --env-file-if-exists=.env.local scripts/live-acceptance.mjs",
    "accept:check": "node --env-file-if-exists=.env.local scripts/live-acceptance.mjs --preflight",
    "deploy:preflight": "node --env-file-if-exists=.env.local scripts/deploy-preflight.mjs",
    "check:deployed": "node scripts/deployed-check.mjs"
  },
  "dependencies": {
    "clocked-sdk": "0.7.0",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.18.1",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.28",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "^5.0.5"
  }
}
